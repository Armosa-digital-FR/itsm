# Copier en .env pour le développement local. Ne jamais commiter de valeur secrète.

# Django
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=postgres://itsm:itsm@localhost:5432/itsm
ITSM_BASE_URL=http://localhost:8000

# Connexion locale par compte de démonstration (uniquement si DEBUG)
DEV_LOGIN=true

# Microsoft Graph : false = e-mails enregistrés sans envoi, pas de synchro réelle
ITSM_GRAPH_ENABLED=false
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_CERTIFICATE_PATH=
ITSM_USE_MANAGED_IDENTITY=false

# Connexion des techniciens (OpenID Connect Entra ID)
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=

# Pièces jointes (production : Azure Blob Storage par identité managée)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER=attachments
